#!/usr/bin/env sh

sudo yabai --load-sa
yabai -m signal --remove all

# --- Core ---
yabai -m config layout bsp
yabai -m config auto_balance on
yabai -m config focus_follows_mouse autofocus

# --- Gaps (optional, adjust) ---
yabai -m config window_gap 2
yabai -m config top_padding 2
yabai -m config bottom_padding 2
yabai -m config left_padding 2
yabai -m config right_padding 2
yabai -m config window_corner_radius 0

# --- Opacity ---
yabai -m config window_opacity on
yabai -m config active_window_opacity 0.90
yabai -m config normal_window_opacity 0.90
yabai -m config window_opacity_duration 0.0

# --- Per-app opacity ---
yabai -m signal --add event=window_created app="^Zen$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"
yabai -m signal --add event=window_created app="^Terminal$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"
yabai -m signal --add event=window_created app="^Finder$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"
yabai -m signal --add event=window_created app="^System Settings$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"
yabai -m signal --add event=window_created app="^Firefox$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"
yabai -m signal --add event=window_created app="^Notes$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"
yabai -m signal --add event=window_created app="^Windows App$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"
yabai -m signal --add event=window_created app="^Alacritty$" action="$HOME/.config/yabai/opacity-delay.sh 0.90"

#borders active_color=0xffe1e3e4 inactive_color=0xff494d64 width=4.0 radius=0 &
