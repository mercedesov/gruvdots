##### Time (RIGHT) #####

sketchybar --add item time_words right \
           --set time_words \
             icon.drawing=off \
             label="--" \
             label.font="Orbitron:Medium:20.0" \
             label.padding_left=12 \
             label.padding_right=12 \
             update_freq=30 \
             script="$PLUGIN_DIR/time_words.sh"

sketchybar --update
