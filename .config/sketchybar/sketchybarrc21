# Minimal config: spaces (left) + time in words (right)

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Optional theme vars (BORDER/BACKGROUND/etc). Safe-guarded.
[ -f "$HOME/.config/themes/current/shellcolors.sh" ] && source "$HOME/.config/themes/current/shellcolors.sh"

##### Bar Appearance #####

bar=(
  position=top
  height=28
  margin=7
  y_offset=2
  blur_radius=30
  color=0x00000000
  corner_radius=7
  border_width=0
  shadow=on
)
sketchybar --bar "${bar[@]}"

##### Defaults #####

default=(
  icon.drawing=off
  label.font="New Rocker:Regular:20.0"
  label.color=0xffffffff
  background.drawing=off
)
sketchybar --default "${default[@]}"

##### Spaces (LEFT) #####

SPACE_COUNT=6

for sid in $(seq 1 "$SPACE_COUNT"); do
  sketchybar --add space "space.$sid" left \
             --set "space.$sid" \
               space="$sid" \
               icon="-" \
               icon.drawing=on \
               icon.padding_left=0 \
               icon.padding_right=0 \
               label.drawing=off \
               background.drawing=on \
               background.height=7 \
               background.width=18 \
               background.color=0xffffffff \
               background.border_width=0 \
               background.corner_radius=2 \
               padding_left=6 \
               padding_right=6 \
               script="$PLUGIN_DIR/space.sh" \
               click_script="yabai -m space --focus $sid"
done

