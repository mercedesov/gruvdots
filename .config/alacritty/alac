[font]
size = 24

[font.normal]
family = "Terminess Nerd Font"
style = "Regular"

[font.bold]
family = "Terminess Nerd Font"
style = "Bold"

[font.italic]
family = "Terminess Nerd Font"
style = "Italic"

[font.bold_italic]
family = "Terminess Nerd Font"
style = "Bold Italic"

[font.offset]
x = 0
y = 1

[window]
decorations = "Buttonless"

[mouse]
hide_when_typing = true

[selection]
save_to_clipboard = true
